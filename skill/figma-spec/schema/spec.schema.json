{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec 页面契约（Z07 figma-spec）",
  "description": "spec 驱动设计的页面数据契约：单源 A/B 变体标识（页级 variants 声明 + 块/项 ver + 字段 k@<变体>）+ rd- 冻结可点码。提取自 zh_code_v2（0020 契约校验/0016 单源化），Z07 泛化：rw/ro 语义重构为任意 abtest 变体。新增块类型/字段 = 稳定层渲染器(build-lib) + gen-vue + 本 schema + skill references/spec-format.md 四处同步。 通用包口径：块级 required 仅收 type（zh 语料中 100% 出现的 sub/h 等在此为可选——渲染器均为可选访问），字段形制仍由 patternProperties+additionalProperties 严格把关。",
  "type": "object",
  "properties": {
    "pageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}$",
      "description": "页面 ID（= spec 文件名/页面目录名；项目可自定前缀分区规约，如 s=登录 bd=投标人）"
    },
    "title": {
      "type": "string",
      "description": "页标题（进 pageCatalog 名称、薄壳注释）"
    },
    "size": {
      "$ref": "#/definitions/xy",
      "description": "画布尺寸 [宽,高]，宽固定 375"
    },
    "at": {
      "$ref": "#/definitions/xy",
      "description": "Figma 画布网格坐标（画板挂载位置，按角色分区）"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,15}$"
      },
      "description": "声明本页的 A/B 变体空间（如 [\"a\",\"b\"]）；用 ver/@<变体> 标记前必须声明，\"all\" 为保留字"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/block"
      }
    }
  },
  "required": [
    "pageId",
    "title",
    "size",
    "blocks"
  ],
  "additionalProperties": false,
  "definitions": {
    "xy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "s": {
      "type": "string"
    },
    "n": {
      "type": "number"
    },
    "b": {
      "type": "boolean"
    },
    "strArr": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pair": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[label,value] 二元组"
    },
    "tri": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 3,
      "description": "2~3 元字符串组（stats4 可带第三段徽标）"
    },
    "code": {
      "type": "string",
      "pattern": "^rd-[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "可点编码冻结码：rd- 前缀 + 字母数字连字符；进 DB（page_clickable/button_binding）后不可改值"
    },
    "verItem": {
      "anyOf": [
        {
          "const": "all",
          "description": "所有变体共有（缺省值，通常直接省略 ver）"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "description": "变体名（须在页级 variants 中声明；如 a/b/lite/pro）"
        }
      ],
      "description": "A/B 变体归属标记：块/对象数组项只在对应变体输出"
    },
    "rowCard": {
      "type": "object",
      "description": "行卡条目（listCard/annList/annFlow 的 rows 项）",
      "properties": {
        "ver": {
          "$ref": "#/definitions/verItem"
        },
        "id": {
          "$ref": "#/definitions/code"
        }
      },
      "patternProperties": {
        "^tag(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/s"
        },
        "^win(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/b"
        },
        "^tagWin(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/b"
        },
        "^title(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/s"
        },
        "^meta(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/s"
        },
        "^right(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/s"
        },
        "^rightDanger(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/b"
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "linkItem": {
      "type": "object",
      "description": "links 项：对象形制才能携带 id（纯字符串形制会被生成器要求改写）",
      "properties": {
        "ver": {
          "$ref": "#/definitions/verItem"
        },
        "id": {
          "$ref": "#/definitions/code"
        }
      },
      "patternProperties": {
        "^t(@[a-z][a-z0-9_]*)?$": {
          "$ref": "#/definitions/s"
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "gridItem": {
      "type": "object",
      "description": "宫格条目（serviceGrid/quickGrid 的 items 项；icon 图标名或 vicon 矢量名二选一）",
      "properties": {
